generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id     Int     @id @default(autoincrement())
  status Boolean @default(true)
  name   String
  email  String  @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Product {
  id         Int    @id @default(autoincrement())
  name       String
  type       String
  quantity   Int
  unit_price Float
  Sale       Sale[]

  @@map("products")
}

model Sale {
  id        Int     @id @default(autoincrement())
  productId Int
  clientId  Int
  adminId   Int
  product   Product @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())

  @@map("sales")
}
