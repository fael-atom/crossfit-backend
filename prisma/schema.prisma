generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  phone     String
  status    Int      @default(1)
  adminId   Int      @default(0)
  picture   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt
  Sale      Sale[]

  @@map("users")
}

model Product {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  type          String
  unitPrice     Float
  stockQuantity Int
  picture       String?
  createdAt     DateTime @default(now())

  @@map("products")
}

model Sale {
  id        Int      @id @default(autoincrement())
  userId    Int
  salesProductsInfo Json
  createdAt DateTime @default(now())

  user              User @relation(fields: [userId], references: [id])

  @@map("sales")
}
