generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  status    Int      @default(1)
  adminId   Int      @default(0)
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@map("users")
}

model Product {
  id            Int    @id @default(autoincrement())
  name          String @unique
  type          String
  stockQuantity Int
  unitPrice     Float
  Sale          Sale[]

  @@map("products")
}

model Sale {
  id        Int @id @default(autoincrement())
  productId Int
  clientId  Int

  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], map: "sales_product_fkey")

  @@index([productId], map: "sales_productId_fkey")
  @@map("sales")
}
